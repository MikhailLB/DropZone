<?xml version="1.0" encoding="utf-8"?>
<!--
    Used by android:dataExtractionRules in the manifest. Excludes every
    prefs / database / file from cloud backup AND device-transfer flows
    so the vault contents never leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
    </device-transfer>
</data-extraction-rules>
